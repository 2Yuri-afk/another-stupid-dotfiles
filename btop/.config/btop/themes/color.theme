Color - Dark Elf Night

# Main background
theme[main_bg]="#1c1d24"

# Main text color
theme[main_fg]="#91acc3"

# Title color
theme[title]="#8ca3b9"

# Highlight for keyboard shortcuts
theme[hi_fg]="#4a8c6a"

# Selected items
theme[selected_bg]="#282c33"
theme[selected_fg]="#91acc3"

# Inactive text
theme[inactive_fg]="#636d7b"

# Graph text
theme[graph_text]="#636d7b"

# Proc misc
